  "reproduction": "Save harnessSource to output/issue1105-performance.mts and run pnpm exec tsx output/issue1105-performance.mts three times in independent processes. Requires the normal local test PostgreSQL service; each process creates and drops only its own test schema. No paid API or production database.",
  "harnessSource": "import assert from 'node:assert/strict'\nimport { writeFile } from 'node:fs/promises'\nimport { createWorkSession } from '../server/__tests__/_helpers/session-fixtures.ts'\nimport { createTestDatabase } from '../server/__tests__/_helpers/postgres.ts'\nimport { PostgresRoomPersistence } from '../server/game/persistence/postgres-adapter.ts'\nimport { RoomHistoryStore } from '../server/game/persistence/room-history-store.ts'\nimport { frameHash, createReplayDelta, type JsonValue } from '../server/game/replay-codec.ts'\nimport { serializeSessionSnapshot, serializeState } from '../shared/session/serialization.ts'\nimport { buildRoomHistoryPage } from '../shared/session/history-window.ts'\nimport { getHistoryRecordIdentity } from '../shared/session/history-streams.ts'\n\nconst db = await createTestDatabase() // isolated disposable schema, never DATABASE_URL\nconst session = createWorkSession({ seed: 563, configure: state => state.players.forEach(p => { p.resources.food = 100 }) })\nconst adapter = new PostgresRoomPersistence(db)\nconst cache = new RoomHistoryStore(db)\nconst meta = { createdBy: null, maxPlayers: 2, customCardDbIds: [], status: 'playing' as const, players: [] }\nconst samples: Record<string, number[]> = {}\nlet writeBytes = 0, newNodes = 0, writes = 0, latestBytes = 0\nlet previousCpu = process.cpuUsage()\nlet previousFrame: JsonValue | undefined\nlet replayDeltaBytes = 0, latestReplayDeltaBytes = 0\nconst timed = <T>(key: string, fn: () => T): T => { const start = performance.now(); const result = fn(); (samples[key] ??= []).push(performance.now() - start); return result }\nconst timedAsync = async <T>(key: string, fn: () => Promise<T>): Promise<T> => { const start = performance.now(); const result = await fn(); (samples[key] ??= []).push(performance.now() - start); return result }\nconst stats = (values: number[] = []) => { const sorted = values.toSorted((a,b) => a-b); return { n: sorted.length, p50_ms: sorted[Math.floor(sorted.length * .5)], p95_ms: sorted[Math.min(sorted.length - 1, Math.floor(sorted.length * .95))] } }\nconst save = async () => {\n  const snapshot = timed('capture', () => serializeSessionSnapshot(session.state, session))\n  // SAFETY: native serialized Frames contain immutable JSON data only.\n  const frame = snapshot.frame as unknown as JsonValue\n  timed('replay_hash', () => frameHash(frame))\n  const delta = timed('replay_delta', () => createReplayDelta(previousFrame ?? frame, frame))\n  latestReplayDeltaBytes = Buffer.byteLength(JSON.stringify(delta))\n  replayDeltaBytes += latestReplayDeltaBytes\n  previousFrame = frame\n  const packed = timed('prepare', () => cache.prepare('history-bench', snapshot))\n  await timedAsync('postgres_save', () => adapter.save('history-bench', snapshot, meta))\n  cache.accept('history-bench', packed.nodes, packed.recoveryNodes)\n  latestBytes = Buffer.byteLength(packed.json)\n  writeBytes += latestBytes + packed.nodes.reduce((n,node) => n + Buffer.byteLength(JSON.stringify(node.value)) + Buffer.byteLength(JSON.stringify({ ...node.identity, continuationId: node.continuationId })),0) + packed.recoveryNodes.reduce((n,node) => n + Buffer.byteLength(node.json),0)\n  newNodes += packed.nodes.length; writes++\n}\nconst points: unknown[] = []\nconst point = async (label: string) => {\n  const canonical = session.withCtx(() => serializeState(session.state, {}))\n  const check = buildRoomHistoryPage(canonical, 'p1')\n  const allPages = [check]\n  while (allPages.at(-1)!.window.nextCursor) allPages.push(buildRoomHistoryPage(canonical,'p1',allPages.at(-1)!.window.nextCursor!))\n  assert.equal(allPages.flatMap(p=>p.log).length, canonical.log.length)\n  assert.equal(allPages.flatMap(p=>p.window.logRecords.map(r=>r.recordId)).length, new Set(allPages.flatMap(p=>p.window.logRecords.map(r=>r.recordId))).size)\n  for (const viewer of ['p1','p2']) {\n    const window = buildRoomHistoryPage(canonical,viewer)\n    for (let index=0;index<30;index++) {\n      timed(`window_${viewer}`, () => session.buildSyncPayload(session.getState(), viewer, undefined, undefined, true))\n      if (window.window.nextCursor) timed(`older_page_${viewer}`, () => buildRoomHistoryPage(canonical,viewer,window.window.nextCursor!))\n    }\n  }\n  const restored = []\n  const restoreCpu = []\n  const row = (await db.prepare('SELECT state_json FROM rooms WHERE id=?').get<{state_json:string}>('history-bench'))!\n  for (let index=0;index<12;index++) {\n    const start = performance.now()\n    const cpu = process.cpuUsage()\n    const value = await new RoomHistoryStore(db).restore('history-bench',row.state_json)\n    restored.push(performance.now()-start)\n    const spent = process.cpuUsage(cpu)\n    restoreCpu.push((spent.user+spent.system)/1000)\n    assert.equal(value.state.events.length, session.state.events.length)\n    assert.equal(value.state.publicEventArchive.length, session.state.publicEventArchive.length)\n    assert.equal(getHistoryRecordIdentity(value.state.events.at(-1)!)?.recordId, getHistoryRecordIdentity(session.state.events.at(-1)!)?.recordId)\n  }\n  const counts = await db.prepare('SELECT count(*)::int AS nodes, sum(octet_length(record_json)+octet_length(identity_json))::bigint AS history_bytes FROM room_history_nodes WHERE room_id=?').get('history-bench')\n  const recovery = await db.prepare('SELECT count(*)::int AS nodes, sum(octet_length(body_json))::bigint AS recovery_bytes FROM room_recovery_nodes WHERE room_id=?').get('history-bench')\n  const cpu = process.cpuUsage(previousCpu)\n  previousCpu = process.cpuUsage()\n  points.push({label,interval_cpu_ms:(cpu.user+cpu.system)/1000, rss_mib:process.memoryUsage().rss/1024/1024,heap_used_mib:process.memoryUsage().heapUsed/1024/1024,restore_cpu_ms:stats(restoreCpu),round:session.state.round, events:session.state.events.length,log:session.state.log.length,archive:session.state.publicEventArchive.length,latestBytes,writes,newNodes,latest_replay_delta_bytes:latestReplayDeltaBytes,cumulative_replay_delta_bytes:replayDeltaBytes,logical_written_document_bytes:writeBytes,counts,recovery,windowBytes:Buffer.byteLength(JSON.stringify(check)),pages:allPages.length,warm_room_restore_ms:stats(restored),samples:Object.fromEntries(Object.entries(samples).map(([key,values])=>[key,stats(values)]))})\n  for (const key of Object.keys(samples)) samples[key]=[]\n}\ntry {\n  await save()\n  for (let actions=1;actions<=48;actions++) {\n    let response = session.getState()\n    while (response.interaction.stateId==='wait') {\n      const request=response.interaction.request\n      assert.ok(request.kind==='confirm-next-player'||request.kind==='confirm-player-switch',request.kind)\n      response=timed('command',()=>session.resolveChoice(request.kind==='confirm-next-player'?request.nextPlayerIndex:request.fromPlayerIndex,'confirm'))\n      assert.ok(response.ok,response.error); await save()\n    }\n    const actor=response.state.currentPlayerIndex\n    const available=session.getActionAvailability(actor)\n    const space=['forest','reed-bank','fishing','day-laborer'].find(id=>available[id])!\n    assert.ok(space)\n    response=timed('command',()=>session.takeAction(actor,space)); assert.ok(response.ok,response.error); await save()\n    if ([12,28,48].includes(actions)) await point(`${actions} legal collection actions`)\n  }\n  const actor=session.state.currentPlayerIndex\n  const event=session.state.events.toReversed().find(e=>e.type==='worker.placed')!\n  assert.ok(event.type==='worker.placed')\n  for(let index=1;index<=200;index++) {\n    assert.ok(timed('command',()=>session.undoAction()).ok); await save()\n    assert.ok(timed('command',()=>session.takeAction(actor,event.spaceId)).ok); await save()\n    if([50,200].includes(index))await point(`48 actions + ${index} legal undo/replacement pairs`)\n  }\n  await writeFile('output/issue1105-performance.json',JSON.stringify({node:process.version,scope:'Current source, deterministic two-player legal collection/undo workload; local PostgreSQL disposable test schema; warm single-Room reads, no distributed/load acceptance. Logical document bytes exclude indexes, PKs, WAL and physical amplification. Collections have sufficient fixture food and placeholder hands; not a card-heavy game.',points},null,2)+'\\n')\n  console.log(JSON.stringify(points,null,2))\n} finally { session.dispose(); await db.close() }\n",
