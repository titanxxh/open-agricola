# Install as <target.directory>/.env, mode 0600; use only pre credentials.
DATABASE_URL=postgres://oa_prerelease_main_app:REPLACE@pre-postgres:5432/oa_prerelease_main
S3_ENDPOINT=http://pre-objects:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=oa-prerelease-main
S3_PREFIX=live/
S3_ACCESS_KEY_ID=REPLACE_PRE_APP_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_PRE_APP_SECRET
# Match only this source-configured target. Never copy a formal admin cookie/key.
PRERELEASE_IDENTITY_SERVICE_KEY=REPLACE_TARGET_ONLY_KEY
