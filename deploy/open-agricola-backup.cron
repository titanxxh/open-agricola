# 安装到生产机：
#   cp deploy/open-agricola-backup.cron /etc/cron.d/open-agricola-backup
#   chmod 644 /etc/cron.d/open-agricola-backup
# 每日 UTC 20:00（北京时间 04:00）运行定时备份 + 异机同步；日志轮转见 deploy/open-agricola-backup.logrotate
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 20 * * * root /root/open-agricola/backup-offsite.sh >> /var/log/open-agricola-backup.log 2>&1
