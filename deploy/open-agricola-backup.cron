# 安装到生产机：
#   cp deploy/open-agricola-backup.cron /etc/cron.d/open-agricola-backup
#   chmod 644 /etc/cron.d/open-agricola-backup
# 先由 ubuntu 创建 /home/ubuntu/open-agricola/logs，并确保仓库与备份归 ubuntu 所有
# 每日北京时间 04:00 运行定时备份 + 异机同步；日志轮转见 deploy/open-agricola-backup.logrotate
# Ubuntu cron 按宿主机时区调度；安装前确认 timedatectl show -p Timezone --value 为 Asia/Shanghai。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 4 * * * ubuntu /home/ubuntu/open-agricola/backup-offsite.sh >> /home/ubuntu/open-agricola/logs/backup.log 2>&1
