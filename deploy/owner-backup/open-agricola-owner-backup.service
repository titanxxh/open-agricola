# Owner machine only (systemd user unit). Install, from the repository checkout:
#   mkdir -p ~/.config/systemd/user ~/.config/open-agricola
#   cp deploy/owner-backup/open-agricola-owner-backup.{service,timer} ~/.config/systemd/user/
#   printf 'OWNER_BACKUP_HOST=ubuntu@<formal-host>\nOWNER_BACKUP_CHECKOUT=%s\n' "$PWD" > ~/.config/open-agricola/owner-backup.env
#   chmod 600 ~/.config/open-agricola/owner-backup.env
#   systemctl --user daemon-reload && systemctl --user enable --now open-agricola-owner-backup.timer
#   loginctl enable-linger "$USER"   # run while logged out
[Unit]
Description=Open Agricola Owner-local Backup: pull, validate and prune ~/oa-backup
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/open-agricola/owner-backup.env
# A login shell provides the owner's Node.js 24 and Docker on PATH.
ExecStart=/bin/bash -lc 'cd "$OWNER_BACKUP_CHECKOUT" && exec node --import tsx scripts/owner-backup.ts run'
TimeoutStartSec=100min
Nice=10
