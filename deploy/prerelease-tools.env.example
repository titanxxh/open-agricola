# Install as <target.directory>/data/dependencies.compose.env, mode 0600.
# Backup role: source SELECT/snapshot only, no source DDL/DML or formal CONNECT.
DATABASE_URL=postgres://oa_prerelease_main_backup:REPLACE@pre-postgres:5432/oa_prerelease_main
# Validator owns ONLY this empty disposable DB; never source DB or source owner.
VALIDATION_DATABASE_URL=postgres://oa_prerelease_main_validator:REPLACE@pre-postgres:5432/oa_prerelease_main_validation
S3_ENDPOINT=http://pre-objects:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=oa-prerelease-main
S3_PREFIX=live/
S3_ACCESS_KEY_ID=REPLACE_PRE_BACKUP_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_PRE_BACKUP_SECRET
