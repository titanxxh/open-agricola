{
  "name": "open-agricola",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run --exclude e2e-tests --exclude scripts/test-actions.spec.ts",
    "test:bench": "RUN_BENCHMARKS=1 vitest run tests/pay-dp.test.ts tests/pay-optimizations.test.ts --testTimeout=20000",
    "test:e2e": "npx playwright test",
    "verify": "bash scripts/verify.sh",
    "check:reaches": "tsx scripts/check-reaches.ts",
    "check:no-dsl": "tsx scripts/check-no-dsl.ts",
    "check:bundle-size": "tsx scripts/check-bundle-size.ts",
    "build:cards-manifest": "tsx scripts/build-cards-manifest.ts",
    "prebuild": "pnpm run build:cards-manifest",
    "check:prompt-sync": "tsx scripts/check-prompt-sync.ts",
    "sync-bga-cdn": "tsx scripts/sync-bga-cdn-github-var.ts",
    "probe-bga-cdn": "tsx scripts/sync-bga-cdn-github-var.ts --probe-only",
    "migrate:dsl-to-code": "tsx scripts/migrate-dsl-to-code.ts",
    "preview": "vite preview",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "canvas": "^3.2.1",
    "isolated-vm": "^6.1.2",
    "nanoid": "^5.1.7",
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "puppeteer": "^24.37.5",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "canvas",
      "isolated-vm",
      "puppeteer",
      "esbuild"
    ]
  }
}
