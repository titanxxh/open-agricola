{
  "name": "open-agricola",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "client/main.tsx",
    "shared/cards/register-all.ts",
    "shared/cards/catalog.ts"
  ],
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:i18n": "tsx scripts/i18n-audit.ts",
    "test": "vitest run --exclude e2e-tests --exclude scripts/test-actions.spec.ts",
    "test:fast": "vitest run --project fast --exclude e2e-tests --exclude scripts/test-actions.spec.ts",
    "test:slow": "vitest run --project slow --exclude e2e-tests --exclude scripts/test-actions.spec.ts",
    "test:llm": "vitest run --project llm --testTimeout=120000",
    "test:bench": "RUN_BENCHMARKS=1 vitest run tests/pay-dp.test.ts tests/pay-optimizations.test.ts --testTimeout=20000",
    "test:e2e": "npx playwright test",
    "verify": "bash scripts/verify.sh",
    "check:reaches": "tsx scripts/check-reaches.ts",
    "check:no-dsl": "tsx scripts/check-no-dsl.ts",
    "check:bundle-size": "tsx scripts/check-bundle-size.ts",
    "check:catalog-types": "tsx scripts/check-catalog-types.ts",
    "build:cards-manifest": "tsx scripts/build-cards-manifest.ts",
    "prebuild": "pnpm run build:cards-manifest",
    "pretest": "pnpm run build:cards-manifest",
    "pretest:fast": "pnpm run build:cards-manifest",
    "pretest:slow": "pnpm run build:cards-manifest",
    "check:prompt-sync": "tsx scripts/check-prompt-sync.ts",
    "smoke:aihubmix": "tsx scripts/aihubmix-smoke-test.ts",
    "smoke:aihubmix:image": "tsx scripts/aihubmix-smoke-test.ts --image-only",
    "smoke:gemini:image": "tsx scripts/aihubmix-smoke-test.ts --image-only --image-provider=gemini --image-model=gemini-2.5-flash-image",
    "sync-bga-cdn": "tsx scripts/sync-bga-cdn-github-var.ts",
    "probe-bga-cdn": "tsx scripts/sync-bga-cdn-github-var.ts --probe-only",
    "migrate:dsl-to-code": "tsx scripts/migrate-dsl-to-code.ts",
    "generate:register-all": "tsx scripts/generate-register-all.ts",
    "check:community-deck": "pnpm run generate:register-all && git diff --exit-code -- shared/cards/register-all.ts shared/cards/community/auto-catalog.ts && pnpm exec vitest run shared/cards/community/__tests__ server/workshop-pr/__tests__",
    "preview": "vite preview",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "canvas": "^3.2.1",
    "isolated-vm": "^6.1.2",
    "nanoid": "^5.1.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "glob": "^13.0.6",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.58.2",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "canvas",
      "isolated-vm",
      "esbuild"
    ]
  }
}
