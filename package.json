{
  "name": "open-agricola",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "client/main.tsx",
    "shared/cards/register-all.ts"
  ],
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:replay-viewer": "pnpm run build:cards-manifest && vite build --config replay-viewer/vite.config.ts && tsx scripts/publish-replay-viewer.ts",
    "replay:remove": "tsx scripts/replay-removal.ts remove",
    "replay:apply-removals": "tsx scripts/replay-removal.ts apply-ledger",
    "lint": "eslint .",
    "lint:i18n": "tsx scripts/i18n-audit.ts",
    "test": "vitest run --exclude e2e-tests --exclude scripts/test-actions.spec.ts",
    "test:fast": "pnpm run check:test-project-coverage && vitest run --project fast-shared --project fast-cards --project fast-card-runtime --project fast-client --project fast-server --project fast-scripts --project fast-tests --exclude e2e-tests --exclude scripts/test-actions.spec.ts",
    "test:slow": "vitest run --project slow --exclude e2e-tests --exclude scripts/test-actions.spec.ts",
    "test:llm": "vitest run --project llm --testTimeout=120000",
    "test:llm:dry": "tsx scripts/llm-acceptance.ts --dry-run",
    "test:llm:live": "tsx scripts/llm-acceptance.ts --live",
    "test:llm:record": "tsx scripts/llm-acceptance.ts --live",
    "test:bench": "RUN_BENCHMARKS=1 vitest run --project fast-tests tests/payment-solver-benchmark.test.ts --testTimeout=20000 --disableConsoleIntercept",
    "test:e2e": "playwright test",
    "verify": "tsx scripts/verify.ts",
    "verify:e2e:browser-sandbox": "VITE_SANDBOX_EXECUTOR=browser tsx scripts/verify.ts e2e-tests/local-sandbox.spec.ts",
    "verify:e2e:webkit": "tsx scripts/verify.ts e2e-tests/frontend-browser-scenario-matrix.spec.ts --browser=webkit --grep @webkit",
    "check:architecture": "pnpm run lint && pnpm run check:test-project-coverage && pnpm run check:test-rule-environments && pnpm run check:test-state-copies && pnpm run check:direct-session-log && pnpm run check:effects-file-list && pnpm run check:generated-cards-sync && pnpm run check:no-dsl -- --strict && pnpm run check:catalog-types && pnpm run check:card-impl-boundaries && pnpm run check:card-state-boundaries && pnpm run check:architecture-types && pnpm run check:architecture-tests && pnpm run check:prompt-sync -- --strict && pnpm run check:dependencies && pnpm run check:browser-boundaries",
    "check:architecture-tests": "vitest run shared/actions/effects/__tests__/architecture-guard.test.ts shared/cards/__tests__/provenance-result-audit.test.ts shared/events/__tests__/event-mapping-policy.test.ts shared/session/__tests__/interaction-command-policy.test.ts shared/cards/__tests__/card-source.test.ts shared/contract/__tests__/prompt-keys.test.ts client/services/__tests__/generation-prompt.test.ts server/__tests__/workshop-prompt-runtime.test.ts scripts/__tests__/ci-card-impl-boundaries.test.ts scripts/__tests__/check-card-state-boundaries.test.ts shared/cards/__tests__/listener-purity-guard.test.ts server/__tests__/listener-purity-gate-session.test.ts scripts/__tests__/check-test-rule-environments.test.ts scripts/__tests__/docs-budget.test.ts scripts/__tests__/check-card-impl-boundaries.test.ts shared/cards/__tests__/listener-admission-registry.test.ts scripts/__tests__/verification.test.ts scripts/__tests__/listener-contract-admission.test.ts",
    "check:no-dsl": "tsx scripts/check-no-dsl.ts",
    "check:test-project-coverage": "tsx scripts/check-test-project-coverage.ts",
    "check:bundle-size": "tsx scripts/check-bundle-size.ts",
    "check:catalog-types": "tsx scripts/check-catalog-types.ts",
    "check:direct-session-log": "tsx scripts/check-direct-session-log.ts",
    "check:card-impl-boundaries": "tsx scripts/check-card-impl-boundaries.ts",
    "check:card-state-boundaries": "tsx scripts/check-card-state-boundaries.ts",
    "check:effects-file-list": "tsx scripts/check-effects-file-list.ts",
    "check:provenance-result-audit": "vitest run shared/cards/__tests__/provenance-result-audit.test.ts",
    "build:cards-manifest": "tsx scripts/build-cards-manifest.ts",
    "prebuild": "pnpm run build:cards-manifest",
    "pretest": "pnpm run build:cards-manifest",
    "pretest:fast": "pnpm run build:cards-manifest",
    "pretest:slow": "pnpm run build:cards-manifest",
    "check:prompt-sync": "tsx scripts/check-prompt-sync.ts",
    "smoke:aihubmix": "tsx scripts/aihubmix-smoke-test.ts",
    "smoke:aihubmix:image": "tsx scripts/aihubmix-smoke-test.ts --image-only",
    "smoke:gemini:image": "tsx scripts/aihubmix-smoke-test.ts --image-only --image-provider=gemini --image-model=gemini-2.5-flash-image",
    "generate:register-all": "tsx scripts/generate-register-all.ts",
    "check:generated-cards-sync": "tsx scripts/check-generated-cards-sync.ts",
    "check:community-deck": "pnpm exec vitest run --project fast-cards --project fast-server shared/cards/community/__tests__ server/workshop-pr/__tests__",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "check:architecture-types": "tsc -p tsconfig.architecture.json --noEmit",
    "check:dependencies": "tsx scripts/check-dependencies.ts",
    "check:browser-boundaries": "tsx scripts/check-browser-boundaries.ts",
    "check:test-rule-environments": "tsx scripts/check-test-rule-environments.ts",
    "check:test-state-copies": "tsx scripts/check-test-state-copies.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@noble/hashes": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "canvas": "^3.2.1",
    "isolated-vm": "^7.0.1",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "@prometheus-io/client": "0.16.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "canvas",
      "isolated-vm",
      "esbuild"
    ],
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.7",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "form-data@>=4.0.0 <4.0.6": "4.0.6"
    }
  }
}
