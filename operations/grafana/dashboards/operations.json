        {
          "refId": "B",
          "expr": "clamp_min(time()-agricola_queue_oldest_enqueued_unixtime,0) and (agricola_queue_oldest_enqueued_unixtime>0)",
          "legendFormat": "{{instance}} oldest seconds",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 11,
      "title": "Returned WS envelope p50 / p95 / p99",
      "type": "timeseries",
      "description": "Actual complete UTF-8 JSON per recipient before WS compression/framing. Round comes from that returned state. Histogram cannot reconstruct exact maximum.",
      "datasource": {
        "type": "prometheus",
        "uid": "agricola-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown / no samples",
          "custom": {
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5,sum by(le)(rate(agricola_ws_outgoing_message_size_bytes_bucket{round=~\"$round\",message_type=\"state\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(agricola_ws_outgoing_message_size_bytes_bucket{round=~\"$round\",message_type=\"state\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99,sum by(le)(rate(agricola_ws_outgoing_message_size_bytes_bucket{round=~\"$round\",message_type=\"state\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "format": "time_series"
        }
      ]
    },
