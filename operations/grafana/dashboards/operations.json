    {
      "id": 17,
      "title": "Confirmed persistence bytes",
      "type": "timeseries",
      "description": "Confirmed logical snapshot reference/body, appended history/recovery records and Replay gzip. Not WAL or physical disk IO.",
      "datasource": {
        "type": "prometheus",
        "uid": "agricola-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown / no samples",
          "custom": {
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
