# Leave the connection group blank to bootstrap PostgreSQL + private S3 locally.
# Generated credentials live in data/local-services.env; no cloud account needed.
# External services: configure, migrate, and validate before switching endpoints.
DATABASE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=
# Preserve this key when moving services (generated locally if blank).
# Local development: one application by default; set 2 to exercise routing.
# Production Compose always starts two application processes on the same host.
APP_INSTANCES=1

# Backend
BACKEND_PORT=5175
# Optional runtime WeChat image directory; restart-local.sh defaults to SHARED_DATA_DIR/community.
# COMMUNITY_DATA_DIR=/absolute/path/data/community
NODE_ENV=production
ALLOW_ANONYMOUS_WS=false
REPLAY_VIEWER_BUILD_ID=
REPLAY_TRUST_PROXY=false
GAME_BUILD_ID=
BUG_REPORTS_ENABLED=false
BUG_REPORT_GITHUB_APP_ID=
BUG_REPORT_GITHUB_CLIENT_ID=
BUG_REPORT_GITHUB_CLIENT_SECRET=
BUG_REPORT_GITHUB_PRIVATE_KEY=
BUG_REPORT_GITHUB_WEBHOOK_SECRET=
BUG_REPORT_GITHUB_INSTALLATION_ID=
# Fixed Bug Report target: titanxxh/open-agricola. The App must be installed there.
BUG_REPORT_GITHUB_REPOSITORY_ID=1164782262
BUG_REPORT_TOKEN_ENCRYPTION_KEYS=
BUG_REPORT_TOKEN_ACTIVE_KEY_ID=

# Admin users (comma-separated usernames)
ADMIN_USERS=your_admin_username
# First deployment: use open to register the first ADMIN_USERS account, then switch to invite_only.
ACCOUNT_REGISTRATION_POLICY=open

# Email verification
EMAIL_DELIVERY=log
RESEND_API_KEY=
EMAIL_FROM="Open Agricola <no-reply@example.com>"
EMAIL_REPLY_TO=

# CORS - 允许 GitHub Pages 前端访问
CORS_ORIGIN=https://open-agricola.your-domain.com
PUBLIC_APP_ORIGIN=https://open-agricola.your-domain.com/
PUBLIC_API_BASE=https://api.your-domain.com

# Frontend build - 构建前端时使用
VITE_API_BASE=https://api.your-domain.com
VITE_WS_BASE=wss://api.your-domain.com/ws

# Workshop GitHub App (submission + review; see docs/operations/github-oauth-app-setup.md)
GITHUB_UPSTREAM_OWNER=titanxxh
GITHUB_UPSTREAM_REPO=open-agricola
WORKSHOP_PR_ENABLED=false
WORKSHOP_REVIEW_GITHUB_APP_ID=
WORKSHOP_REVIEW_GITHUB_PRIVATE_KEY=
WORKSHOP_REVIEW_GITHUB_INSTALLATION_ID=
WORKSHOP_REVIEW_GITHUB_WEBHOOK_SECRET=
# Optional project-owned read credential for public LLM reference metadata.
# If empty, the backend uses the Workshop App's independent read token.
# Never use a VITE_ variable or a user's LLM key here.
WORKSHOP_REFERENCE_GITHUB_TOKEN=

# Account OAuth Apps (login/register)
ACCOUNT_GITHUB_OAUTH_CLIENT_ID=
ACCOUNT_GITHUB_OAUTH_CLIENT_SECRET=
ACCOUNT_GOOGLE_OAUTH_CLIENT_ID=
ACCOUNT_GOOGLE_OAUTH_CLIENT_SECRET=

# For pnpm test:llm — Gemini API key (Google AI Studio)
# MY_TEST_GEMINI_APIKEY=

# Optional separate empty PostgreSQL database for backup validation on managed services.
# Leave unset for local Compose; validation creates and removes its own database.
VALIDATION_DATABASE_URL=
