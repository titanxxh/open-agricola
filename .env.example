# Backend
BACKEND_PORT=5175
NODE_ENV=production
PERSIST_ROOMS=sqlite
ALLOW_ANONYMOUS_WS=false

# CORS — set to your GitHub Pages URL in production
# CORS_ORIGIN=https://username.github.io

# Frontend build — set before `npm run build`
# VITE_API_BASE=https://your-backend.example.com
# VITE_WS_BASE=wss://your-backend.example.com/ws
