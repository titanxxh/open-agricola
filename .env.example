# Backend
BACKEND_PORT=5175
NODE_ENV=production
PERSIST_ROOMS=sqlite
ALLOW_ANONYMOUS_WS=false

# Admin users (comma-separated usernames)
ADMIN_USERS=xxh

# CORS - 允许 GitHub Pages 前端访问
CORS_ORIGIN=https://titanxxh.github.io

# BGA CDN URL - 更新时替换版本 hash（如 260329-0408）
BGA_CDN_BASE_URL=https://x.boardgamearena.net/data/themereleases/current/games/agricola/260329-0408/img

# Frontend build - 构建前端时使用
VITE_API_BASE=https://open-agricola.duckdns.org
VITE_WS_BASE=wss://open-agricola.duckdns.org/ws

# GitHub OAuth App (for workshop -> PR integration; see docs/operations/github-oauth-app-setup.md)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_UPSTREAM_OWNER=titanxxh
GITHUB_UPSTREAM_REPO=open-agricola
WORKSHOP_PR_ENABLED=false

# For pnpm test:llm — Gemini API key (Google AI Studio)
# MY_TEST_GEMINI_APIKEY=
